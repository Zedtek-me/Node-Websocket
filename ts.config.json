{
    "compilerOptions": {
      "module": "system",
      "noImplicitAny": true,
      "removeComments": true,
      "preserveConstEnums": true,
      "outFile": "emitted/app.js",
      "sourceMap": true,
      "rootDir": "."
    },
    "include": ["src/**/*", "src/**/**/*.ts"],
    "exclude": ["**/*.spec.ts", "node_modules"]
  }